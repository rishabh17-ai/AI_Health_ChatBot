# MongoDB Connection String (Replace with your local MongoDB or Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/health-chatbot

# JWT Signing Secret (Change to a secure random string)
JWT_SECRET=your_jwt_secret_here

# Google Gemini API Key (Get free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=5000
